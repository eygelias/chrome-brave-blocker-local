{
  "manifest_version": 3,
  "name": "Brave-like Blocker Local (Chrome)",
  "version": "3.0.1",
  "description": "Bloqueador local inspirado en Brave | Local ad/tracker blocker inspired by Brave.",
  "homepage_url": "https://github.com/eygelias/chrome-brave-blocker-local",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1_1",
        "enabled": true,
        "path": "rulesets/ruleset_1_1/ruleset_1_1.json"
      },
      {
        "id": "ruleset_1_2",
        "enabled": true,
        "path": "rulesets/ruleset_1_2/ruleset_1_2.json"
      },
      {
        "id": "ruleset_1_3",
        "enabled": true,
        "path": "rulesets/ruleset_1_3/ruleset_1_3.json"
      },
      {
        "id": "ruleset_2_1",
        "enabled": true,
        "path": "rulesets/ruleset_2_1/ruleset_2_1.json"
      },
      {
        "id": "ruleset_2_2",
        "enabled": true,
        "path": "rulesets/ruleset_2_2/ruleset_2_2.json"
      },
      {
        "id": "ruleset_3",
        "enabled": true,
        "path": "rulesets/ruleset_3/ruleset_3.json"
      },
      {
        "id": "ruleset_4",
        "enabled": true,
        "path": "rulesets/ruleset_4/ruleset_4.json"
      },
      {
        "id": "ruleset_5",
        "enabled": true,
        "path": "rulesets/ruleset_5/ruleset_5.json"
      },
      {
        "id": "ruleset_6",
        "enabled": true,
        "path": "rulesets/ruleset_6/ruleset_6.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*",
        "*://tv.youtube.com/*",
        "*://www.youtubekids.com/*",
        "*://www.youtube-nocookie.com/*"
      ],
      "css": [
        "cosmetic.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*",
        "*://tv.youtube.com/*",
        "*://www.youtubekids.com/*",
        "*://www.youtube-nocookie.com/*"
      ],
      "js": [
        "yt-main.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://m.youtube.com/*"
      ],
      "js": [
        "brave-yt-sabr-fix.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "120"
}
